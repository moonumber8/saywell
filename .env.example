OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
# Text AI: qwen-chat uses Alibaba Cloud; ollama uses a local model.
AI_PROVIDER=qwen-chat
QWEN_MODEL=qwen3.8-flash
# Dedicated speech-to-text model used for learner recordings. It does not
# control course planning or interactive text feedback.
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_REGION=ap-southeast-1
QWEN_WORKSPACE_ID=
QWEN_API_KEY=
# Optional explicit workspace-specific wss:// endpoint:
QWEN_REALTIME_URL=
# Example speech uses local Kokoro-82M; no cloud key or TTS quota required.
KOKORO_VOICE=af_heart
# Optional absolute paths; defaults use the private runtime and models/kokoro.
KOKORO_PYTHON=
KOKORO_MODEL_PATH=
KOKORO_VOICES_PATH=
# Course planning: use Flash for routine imports; leave empty to inherit AI_PROVIDER.
# Qwen chat inherits the server-only QWEN key, workspace and region.
COURSE_AI_PROVIDER=
COURSE_AI_MODEL=qwen3.8-flash
# json_object uses the schema in the prompt plus source validation; json_schema enforces it at the API.
COURSE_AI_STRUCTURED_MODE=json_object
# Optional HTTPS compatible-mode/v1 endpoint or a separate server-only key:
COURSE_AI_BASE_URL=
COURSE_AI_KEY=
PORT=3001
PUBLIC_PORT=4173
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=saywell_curriculum
# Optional for a remote Qdrant server:
QDRANT_API_KEY=
